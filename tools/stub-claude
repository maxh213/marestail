#!/usr/bin/env python3
import json, os, re, subprocess, sys
from pathlib import Path
prompt = sys.stdin.read()
plan = Path(os.environ["STUB_PLAN"])
lines = plan.read_text().splitlines()
action, rest = lines[0], lines[1:]
plan.write_text("".join(line + "\n" for line in rest))
root = Path.cwd()
def sh(*cmd): subprocess.run(cmd, cwd=root, check=True, capture_output=True)
def commit(role, *paths):
    if paths: sh("git", "add", *paths)
    sh("git", "commit", "-q", "--allow-empty", "-m", f"{action}\n\nBy {role}.")
def hunks_section(lines):
    return "## Hunks\n" + "".join(line + "\n" for line in lines) if lines else ""
def handoff_path():
    return root / re.search(r"Write (\.marestail/\S+?):", prompt).group(1)
def verdict_path():
    return Path(re.search(r"Write your verdict to (\S+) and", prompt).group(1))
words = action.split()
if words[0] == "specify":
    Path("features").mkdir(exist_ok=True); Path("qa").mkdir(exist_ok=True)
    Path("features/t.feature").write_text("Feature: t\n  Scenario: Adds one\n    Given x\n  Scenario Outline: Rejects bad input\n    Given y\n")
    Path("qa/t.md").write_text("1. open\n")
    commit("specifier", "features", "qa")
    h = handoff_path(); h.parent.mkdir(parents=True, exist_ok=True); h.write_text("spec written\n")
elif words[0] == "judge":
    if "EDIT" in words:
        Path("src.py").write_text("tampered\n")
    v = verdict_path(); v.parent.mkdir(parents=True, exist_ok=True)
    verdict = " ".join(w for w in words[1:] if w != "EDIT")
    v.write_text(f"VERDICT: {verdict}\n1. finding from {v.stem}\n")
elif words[0] == "perf":
    bench = Path("perf/bench_t.py"); bench.parent.mkdir(exist_ok=True)
    bench.write_text('#!/usr/bin/env python3\nimport json, os\nvalue = {"pre-marestail": 8, "baseline": 10, "head": 20}[os.environ["MARESTAIL_PERF_TREE"]]\nprint(json.dumps({"target": "add_one", "unit": "ms", "better": "lower", "values": [value] * 200}))\n')
    bench.chmod(0o755)
    for tree in json.loads(Path(".marestail/perf/trees.json").read_text())["trees"]:
        sh("marestail", "perf", "run", "perf/bench_t.py", "--tree", tree["tree"], "--samples", "10")
    v = verdict_path(); v.parent.mkdir(parents=True, exist_ok=True)
    body = "1. add_one is twice as slow; batch the work in src.py:1\n" if words[1] == "BOUNCE" else "## Degradations\n- add_one: +100% p50, accepted: Adds one\n"
    v.write_text(f"VERDICT: {words[1]}\n{body}")
elif words[0] == "code":
    paths = ["tests"]
    listed = ["- src.py:1-2 — the fix needs it"]
    if "five-tests" not in words:
        Path("src.py").write_text("def add_one(x):\n    return x + 1\n"); paths.append("src.py")
    Path("tests").mkdir(exist_ok=True); Path("tests/test_src.py").write_text("def test_adds_one():\n    pass\ndef test_rejects_bad_input():\n    pass\n")
    if "five-tests" in words:
        for name in "abcd": Path(f"tests/test_{name}.py").write_text(f"def test_{name}():\n    pass\n")
        listed = ["- util.py:3-3 — the fix needs it"]
    util = Path("util.py")
    lines = util.read_text().splitlines(True) if util.exists() else []
    if "reindent" in words or "reindent-fix" in words:
        lines[1:4] = ["    " + line for line in lines[1:4]]
    if "reindent-fix" in words:
        lines[2] = "            return 2\n"; listed.append("- util.py:2-4 — the fix needs it")
    if "miss-util" in words or "five-tests" in words:
        lines[2] = "        return 2\n"
    if "bare" in words: listed.append("util.py:3-3 — the fix needs it")
    if "single" in words: listed.append("* util.py:3 - the fix needs it")
    if lines: util.write_text("".join(lines))
    if "rename" in words: sh("git", "mv", "util.py", "helpers.py")
    if "delete" in words: sh("git", "rm", "-q", "util.py")
    if util.exists(): paths.append("util.py")
    if "package" in words:
        Path("package.json").write_text("{}\n"); paths.append("package.json")
    if "no-hunks" in words: listed = []
    if "revert" in words:
        Path("marestail.toml").write_text('[git]\nbase = "main"\n'); paths.append("marestail.toml")
    if "freeze" in words:
        Path("marestail.toml").write_text(Path("marestail.toml").read_text() + "\n[python]\ncrap_max = 99\n"); paths.append("marestail.toml")
    commit("coder", *paths)
    h = handoff_path(); h.parent.mkdir(parents=True, exist_ok=True)
    audit = "" if "bad-audit" in words else "## Audit\n- Adds one -> tests/test_src.py::test_adds_one\n- Rejects bad input -> tests/test_src.py::test_rejects_bad_input\n"
    explain = "## Config change\nTests moved, so the test path must follow.\n" if "explain" in words else ""
    h.write_text(f"coded\n{audit}{explain}{hunks_section(listed)}")
elif words[0] == "architect":
    tag = words[1] if len(words) > 1 else ""
    if tag == "extract":
        Path("src.py").write_text("def add_one(x):\n    return increment(x)\n\n\ndef increment(x):\n    return x + 1\n"); commit("architect", "src.py")
    else:
        commit("architect")
    listed = {"no-hunks": [], "util": ["- util.py:3-3 — the fix needs it"], "extract": ["- src.py:1-6 — boy scout: named the increment in add_one"]}
    h = handoff_path(); h.parent.mkdir(parents=True, exist_ok=True)
    h.write_text(f"architect done\n{hunks_section(listed.get(tag, ['- src.py:1-2 — the fix needs it']))}")
elif words[0] == "worker":
    role = words[1]
    Path("note.txt").write_text(action + "\n"); commit(role, "note.txt")
    h = handoff_path(); h.parent.mkdir(parents=True, exist_ok=True)
    tag = words[2] if len(words) > 2 else ("app" if role == "qa" else "")
    bodies = {
        "app": "ran-against: app\n",
        "harness": "ran-against: harness\n",
        "nothing": "ran-against: nothing\n",
        "sentence": "We ran-against: app on a harness.\n",
        "omit": "",
    }
    h.write_text(f"{role} done\n{bodies.get(tag, '')}")
print(json.dumps({"is_error": False, "num_turns": 1, "total_cost_usd": 0.01, "result": action}))
