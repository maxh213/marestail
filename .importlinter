[importlinter]
root_package = marestail

[importlinter:contract:layers]
name = Dependencies point down: TUI, CLI, pipeline commands, prompts, gates, depth/graph, language adapters, context, then shell
type = layers
layers =
    marestail.tui
    marestail.cli
    marestail.runner : marestail.install : marestail.route : marestail.perf : marestail.sonar.setup : marestail.backends
    marestail.prompts : marestail.audit : marestail.practices
    marestail.gates
    marestail.depth : marestail.graph
    marestail.dotnet : marestail.erlang : marestail.java : marestail.ruby : marestail.rust : marestail.javascript : marestail.elixir
    marestail.context : marestail.pipeline : marestail.freeze : marestail.sonar.client : marestail.timeline
    marestail.report : marestail.config : marestail.changes
    marestail.shell

[importlinter:contract:gates-do-not-reach-up]
name = Gates never import the runner, the CLI, the prompts or the pipeline
type = forbidden
source_modules =
    marestail.gates
forbidden_modules =
    marestail.runner
    marestail.cli
    marestail.prompts
    marestail.pipeline
    marestail.tui
    marestail.perf
    marestail.install
    marestail.route
    marestail.audit
    marestail.practices
    marestail.sonar.setup
    marestail.timeline

[importlinter:contract:foundations-import-nothing-above]
name = Context, report, shell, config and changes import nothing above them
type = forbidden
source_modules =
    marestail.context
    marestail.report
    marestail.shell
    marestail.config
    marestail.changes
    marestail.pipeline
    marestail.freeze
    marestail.sonar.client
    marestail.timeline
forbidden_modules =
    marestail.gates
    marestail.runner
    marestail.cli
    marestail.prompts
    marestail.pipeline
    marestail.install
    marestail.tui
    marestail.perf
    marestail.route
    marestail.graph
    marestail.depth
    marestail.audit
    marestail.practices
    marestail.freeze
    marestail.dotnet
    marestail.erlang
    marestail.java
    marestail.ruby
    marestail.rust
    marestail.javascript
    marestail.elixir
    marestail.sonar.setup
    marestail.backends

[importlinter:contract:language-adapters-stay-below-gates]
name = Language adapters never import gates, the runner, the CLI or perf
type = forbidden
source_modules =
    marestail.dotnet
    marestail.erlang
    marestail.java
    marestail.ruby
    marestail.rust
    marestail.javascript
    marestail.elixir
forbidden_modules =
    marestail.gates
    marestail.runner
    marestail.cli
    marestail.prompts
    marestail.pipeline
    marestail.install
    marestail.tui
    marestail.perf
    marestail.route
    marestail.audit
    marestail.practices
    marestail.graph
    marestail.depth
    marestail.timeline

[importlinter:contract:protect-gate-internals]
name = Gate helpers are private to gates
type = protected
protected_modules =
    marestail.gates._cycles
    marestail.gates._crap
    marestail.gates._coverage
allowed_importers =
    marestail.gates

[importlinter:contract:backends-do-not-reach-up]
name = Backends do not import higher layers
type = forbidden
source_modules =
    marestail.backends
forbidden_modules =
    marestail.runner
    marestail.cli
    marestail.prompts
    marestail.pipeline
    marestail.tui
    marestail.perf
    marestail.install
    marestail.route
    marestail.audit
    marestail.practices
    marestail.sonar.setup
    marestail.graph
    marestail.depth
    marestail.gates
    marestail.timeline

[importlinter:contract:timeline-stays-below-runner]
name = Timeline artefacts do not import orchestration or agents
type = forbidden
source_modules =
    marestail.timeline
forbidden_modules =
    marestail.runner
    marestail.cli
    marestail.prompts
    marestail.pipeline
    marestail.tui
    marestail.perf
    marestail.install
    marestail.route
    marestail.audit
    marestail.practices
    marestail.sonar.setup
    marestail.backends
    marestail.gates
    marestail.graph
    marestail.depth
    marestail.freeze
