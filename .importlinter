[importlinter]
root_package = marestail

[importlinter:contract:layers]
name = Dependencies point down: TUI, CLI, pipeline commands, install internals, prompts, gates, depth/graph, language adapters, context, then shell
type = layers
layers =
    marestail.tui
    marestail.cli
    marestail.runner : marestail.install : marestail.route : marestail.perf : marestail.sonar.setup : marestail.backends
    marestail._install
    marestail.prompts : marestail.audit : marestail.practices
    marestail.gates
    marestail.depth : marestail.graph
    marestail.dotnet : marestail.erlang : marestail.java : marestail.ruby : marestail.rust : marestail.javascript : marestail.elixir
    marestail.context : marestail.pipeline : marestail.freeze : marestail.sonar.client : marestail.timeline : marestail.ran_against
    marestail.report : marestail.config : marestail.changes : marestail._location
    marestail.shell

[importlinter:contract:gates-do-not-reach-up]
name = Gates never import the runner, the CLI, the prompts or the pipeline
type = forbidden
source_modules =
    marestail.gates
forbidden_modules =
    marestail.runner
    marestail.cli
    marestail.prompts
    marestail.pipeline
    marestail.tui
    marestail.perf
    marestail.install
    marestail._install
    marestail.route
    marestail.audit
    marestail.practices
    marestail.sonar.setup
    marestail.timeline
    marestail.ran_against

[importlinter:contract:foundations-import-nothing-above]
name = Context, report, shell, config and changes import nothing above them
type = forbidden
source_modules =
    marestail.context
    marestail.report
    marestail.shell
    marestail.config
    marestail.changes
    marestail._location
    marestail.pipeline
    marestail.freeze
    marestail.sonar.client
    marestail.timeline
    marestail.ran_against
forbidden_modules =
    marestail.gates
    marestail.runner
    marestail.cli
    marestail.prompts
    marestail.pipeline
    marestail.install
    marestail._install
    marestail.tui
    marestail.perf
    marestail.route
    marestail.graph
    marestail.depth
    marestail.audit
    marestail.practices
    marestail.freeze
    marestail.dotnet
    marestail.erlang
    marestail.java
    marestail.ruby
    marestail.rust
    marestail.javascript
    marestail.elixir
    marestail.sonar.setup
    marestail.backends

[importlinter:contract:language-adapters-stay-below-gates]
name = Language adapters never import gates, the runner, the CLI or perf
type = forbidden
source_modules =
    marestail.dotnet
    marestail.erlang
    marestail.java
    marestail.ruby
    marestail.rust
    marestail.javascript
    marestail.elixir
forbidden_modules =
    marestail.gates
    marestail.runner
    marestail.cli
    marestail.prompts
    marestail.pipeline
    marestail.install
    marestail._install
    marestail.tui
    marestail.perf
    marestail.route
    marestail.audit
    marestail.practices
    marestail.graph
    marestail.depth
    marestail.timeline
    marestail.ran_against

[importlinter:contract:protect-gate-internals]
name = Gate helpers are private to gates
type = protected
protected_modules =
    marestail.gates._cycles
    marestail.gates._crap
    marestail.gates._hyper_crap
    marestail.gates._coverage
    marestail.gates._serve
allowed_importers =
    marestail.gates

[importlinter:contract:crap-belongs-to-crap-gates]
name = CRAP scoring and the hyper no-worse-than-base rules are private to the CRAP gates
type = protected
protected_modules =
    marestail.gates._crap
    marestail.gates._hyper_crap
allowed_importers =
    marestail.gates._hyper_crap
    marestail.gates.py_crap
    marestail.gates.ts_crap
    marestail.gates.rb_crap
    marestail.gates.rs_crap
    marestail.gates.cs_crap
    marestail.gates.java_crap
    marestail.gates.ex_crap
    marestail.gates.er_crap

[importlinter:contract:hyper-crap-above-crap]
name = Hyper CRAP builds on CRAP scoring, never the other way
type = forbidden
source_modules =
    marestail.gates._crap
forbidden_modules =
    marestail.gates._hyper_crap

[importlinter:contract:serve-belongs-to-qa]
name = The app lifecycle is private to the qa gate
type = protected
protected_modules =
    marestail.gates._serve
allowed_importers =
    marestail.gates.qa

[importlinter:contract:protect-location-internals]
name = Reading a path:line out of finding text is private to the context's changed-line filter
type = protected
protected_modules =
    marestail._location
allowed_importers =
    marestail.context

[importlinter:contract:protect-install-internals]
name = Install helpers are private to install
type = protected
protected_modules =
    marestail._install
allowed_importers =
    marestail.install

[importlinter:contract:backends-do-not-reach-up]
name = Backends do not import higher layers
type = forbidden
source_modules =
    marestail.backends
forbidden_modules =
    marestail.runner
    marestail.cli
    marestail.prompts
    marestail.pipeline
    marestail.tui
    marestail.perf
    marestail.install
    marestail._install
    marestail.route
    marestail.audit
    marestail.practices
    marestail.sonar.setup
    marestail.graph
    marestail.depth
    marestail.gates
    marestail.timeline
    marestail.ran_against

[importlinter:contract:timeline-stays-below-runner]
name = Timeline artefacts do not import orchestration or agents
type = forbidden
source_modules =
    marestail.timeline
forbidden_modules =
    marestail.runner
    marestail.cli
    marestail.prompts
    marestail.pipeline
    marestail.tui
    marestail.perf
    marestail.install
    marestail._install
    marestail.route
    marestail.audit
    marestail.practices
    marestail.sonar.setup
    marestail.backends
    marestail.gates
    marestail.graph
    marestail.depth
    marestail.freeze

[importlinter:contract:ran-against-stays-below-runner]
name = Ran-against domain does not import orchestration, agents or TUI
type = forbidden
source_modules =
    marestail.ran_against
forbidden_modules =
    marestail.runner
    marestail.cli
    marestail.prompts
    marestail.pipeline
    marestail.tui
    marestail.perf
    marestail.install
    marestail._install
    marestail.route
    marestail.audit
    marestail.practices
    marestail.sonar.setup
    marestail.backends
    marestail.gates
    marestail.graph
    marestail.depth
    marestail.freeze
    marestail.timeline

[importlinter:contract:pipeline-belongs-to-orchestration]
name = The role list and how a scope reshapes it are known only to the runner and the prompt builder
type = protected
protected_modules =
    marestail.pipeline
allowed_importers =
    marestail.runner
    marestail.prompts
