    marestail.audit
    marestail.practices
    marestail.sonar.setup
    marestail.backends
    marestail.gates
    marestail.graph
    marestail.depth
    marestail.freeze

[importlinter:contract:ran-against-stays-below-runner]
name = Ran-against domain does not import orchestration, agents or TUI
type = forbidden
source_modules =
    marestail.ran_against
forbidden_modules =
    marestail.hunks
    marestail.runner
    marestail.cli
    marestail.prompts
    marestail.pipeline
    marestail.tui
    marestail.perf
    marestail.install
    marestail._install
    marestail._hyper
    marestail._tooling
    marestail.route
    marestail.audit
    marestail.practices
    marestail.sonar.setup
    marestail.backends
    marestail.gates
    marestail.graph
    marestail.depth
    marestail.freeze
    marestail.timeline

[importlinter:contract:pipeline-belongs-to-orchestration]
name = The role list and how a scope reshapes it are known only to the runner and the prompt builder
type = protected
protected_modules =
    marestail.pipeline
allowed_importers =
    marestail.runner
    marestail.prompts

[importlinter:contract:hunk-check-belongs-to-runner]
name = The hyper hunk check and the blast review are asked for only by the runner
type = protected
protected_modules =
    marestail.hunks
allowed_importers =
    marestail.runner

[importlinter:contract:hunk-check-reads-only-git-and-freeze]
name = The hunk check reads git and the file classes, never orchestration, prompts or gates
type = forbidden
source_modules =
    marestail.hunks
forbidden_modules =
    marestail.runner
    marestail.cli
    marestail.prompts
    marestail.pipeline
    marestail.tui
    marestail.perf
    marestail.install
    marestail._install
    marestail._hyper
    marestail._tooling
    marestail.route
    marestail.audit
